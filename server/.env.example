# Kopieren nach .env und mit echten Werten füllen.
# NIEMALS echte Secrets committen — .env ist gitignored.

# Schützt POST /api/admin/freischalten (Freigabe/Ablehnung neuer AKI-Profile).
ADMIN_SECRET=change-me-admin-secret

# Reserviert für eine künftige Umstellung auf signierte Session-Cookies/JWT.
# Aktuell NICHT in Verwendung — Sessions sind serverseitig gehaltene Zufalls-
# Token (crypto.randomBytes), kein Signatur-Verfahren nötig im Scaffold-Stadium.
SESSION_SECRET=change-me-session-secret

PORT=3010
# Basis-URL für den im Server-Log ausgegebenen Magic-Link (kein echter Mailversand).
BASE_URL=http://localhost:3010
